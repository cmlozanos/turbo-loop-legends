{
  "name": "turbo-loop-legends",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:cache": "node tools/verify-cache-busting.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:cache",
    "poc:physics": "tsx tools/physics-poc.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "planck": "1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.1.0",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.0.2",
    "vitest": "3.2.7"
  }
}
